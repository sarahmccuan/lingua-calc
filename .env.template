# Lingua Calc configuration
# ---------------------------------------------------------------------------
# 1. Copy this file to ".env" (same folder):   copy .env.template .env
# 2. Paste in the three AWS values (sent to you separately).
# 3. Save. That's it — the app reads .env automatically on every launch.
# ---------------------------------------------------------------------------

# AWS region where Bedrock + the model are enabled.
AWS_REGION=us-east-1

# Your Amazon Bedrock access key (keep .env private; do not commit or share it).
AWS_ACCESS_KEY_ID=PASTE_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=PASTE_SECRET_ACCESS_KEY_HERE

# ---------------------------------------------------------------------------
# Optional — the defaults are good; only change if asked to.
# ---------------------------------------------------------------------------
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# LINGUA_MAX_WORKERS=8
# LINGUA_MAX_CHUNK_CHARS=1200
# LINGUA_DEBUG_TRACEBACKS=false
